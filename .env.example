# Copy to .env and fill in values.
# Production: docker compose --env-file .env up -d
# Development (no VPN): docker compose -f docker-compose.dev.yml --env-file .env up -d

# --- Web UI login ---
WEB_PASSWORD=change-me-web-password
SESSION_SECRET=change-me-long-random-session-secret

# --- Bearer token for finished-file API ---
API_BEARER_TOKEN=change-me-long-random-api-token

# --- Encryption (RSA public key wraps AES-256-GCM) ---
# Generate: openssl genrsa -out data/keys/private.pem 2048
#           openssl rsa -in data/keys/private.pem -pubout -out data/keys/public.pem
# Keep private.pem offline; only public.pem is mounted into the container.
ENCRYPTION_PUBLIC_KEY_PATH=/keys/public.pem

# --- Paths inside container ---
DOWNLOAD_DIR=/data/downloads
COMPLETED_DIR=/data/completed

# --- Dev / VPN ---
# true = skip VPN health checks (docker-compose.dev.yml sets this)
DEV_MODE=false
# Gluetun control API (reachable at 127.0.0.1 when network_mode=service:gluetun)
GLUETUN_CONTROL_URL=http://127.0.0.1:8001

# --- Gluetun (production only; leave blank in .env until you have credentials) ---
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
# WireGuard example (Mullvad / custom):
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# OpenVPN example instead:
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=
SERVER_COUNTRIES=Netherlands

# --- ntfy (optional push notifications) ---
# Subscribe to the topic in the ntfy app / https://ntfy.sh/<topic>
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optional access token for private topics / self-hosted auth
NTFY_TOKEN=
NTFY_PRIORITY=3
# Events: completed,failed,vpn,all (comma-separated)
NTFY_EVENTS=completed,failed,vpn
